# Copy this file to .env.local and fill in your real values.
# .env.local is already in .gitignore so it stays private.

# MongoDB Atlas connection string (Atlas dashboard -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/deliveries-hub

# Any long random string, used to sign login tokens. Keep this secret.
JWT_SECRET=replace_this_with_a_long_random_string

# Stripe Payment Gateway Keys (From https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_CURRENCY=pkr
